# Copy this file to .env. Never commit .env.
# 复制为 .env 使用，绝对不要提交真实令牌。

# Local Ollama endpoint used by Open WebUI inside Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Quick start uses the rolling :main tag. For reproducible long-term use,
# replace it with a release tag you have tested, for example :vX.Y.Z.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Optional cloud providers. Leave blank until the corresponding chapter.
DASHSCOPE_API_KEY=
# Keep Coding Plan credentials separate from ordinary DashScope keys.
BAILIAN_CODING_PLAN_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Change this before exposing any gateway beyond localhost.
LOCAL_GATEWAY_KEY=replace-with-a-long-random-local-secret
